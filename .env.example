# Copy to .env (`cp .env.example .env`) and fill in real values.
# .env is gitignored; this example is committed so the required variables are
# documented.

# --- API -------------------------------------------------------------------
PORT=8000
# Connection string used by the Go API (config/config.go binds DATABASE_URL).
# When unset, docker compose defaults it to the `postgres` service:
#   postgres://app:app@postgres:5432/app?sslmode=disable
# If you change POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB below, set
# DATABASE_URL to match.
DATABASE_URL=postgres://app:app@postgres:5432/app?sslmode=disable

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# --- OTel Collector -> S3 log archival -------------------------------------
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
